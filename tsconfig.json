{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "tests", "prototypes", "vite.config.ts"]
}
